        "type": "function",
        "z": "7156df95dd73e491",
        "name": "Temperature Transformation (Historical)",
        "func": "let data = [];\n\nfor (let item of msg.payload) {\n\n    data.push({\n        x: new Date(item._time),\n        y: item._value\n    });\n\n}\n\nmsg.payload = [{\n    series: [\"Temperature\"],\n    data: [data],\n    labels: []\n}];\n\nreturn msg;",
